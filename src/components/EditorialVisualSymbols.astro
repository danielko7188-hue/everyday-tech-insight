---
import { categorySlugs, type CategorySlug } from "../data/categories";
import {
  EDITORIAL_VISUAL_KEYS,
  type ArticleVisual,
} from "../utils/content-contract";

type EditorialVisualSymbolId = CategorySlug | ArticleVisual["key"];

interface Props {
  symbolIds: readonly EditorialVisualSymbolId[];
}

const { symbolIds } = Astro.props;
const allowedSymbolIds = new Set<string>([
  ...categorySlugs,
  ...EDITORIAL_VISUAL_KEYS,
]);
const requestedSymbolIds = new Set<string>(symbolIds);

for (const symbolId of requestedSymbolIds) {
  if (!allowedSymbolIds.has(symbolId)) {
    throw new Error(`Unknown editorial visual symbol: ${symbolId}`);
  }
}

const shouldRender = (symbolId: EditorialVisualSymbolId) =>
  requestedSymbolIds.has(symbolId);
