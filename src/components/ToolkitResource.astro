---
interface FieldDefinition {
  name: string;
  guidance: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  guideHref: string;
  guideLabel: string;
  downloadHref: string;
  downloadLabel: string;
  fields: readonly FieldDefinition[];
}

const {
  id,
  title,
  description,
  guideHref,
  guideLabel,
  downloadHref,
  downloadLabel,
  fields,
} = Astro.props;
---

<section class="toolkit-resource" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <p>{description}</p>
  <p class="toolkit-resource__actions">
    <a href={guideHref}>{guideLabel}</a>
    <span aria-hidden="true">·</span>
    <a href={downloadHref} download>{downloadLabel}</a>
  </p>
  <p class="toolkit-resource__scroll-hint">
    Scroll the field guide horizontally on a small screen.
  </p>
  <div
    class="table-scroll"
    role="region"
    aria-label={`${title} field guide`}
    tabindex="0"
    data-horizontal-scroll
  >
    <table>
      <caption class="visually-hidden">{title} fields and instructions</caption>
      <thead>
        <tr>
          <th scope="col">Field</th>
          <th scope="col">What to record</th>
        </tr>
      </thead>
      <tbody>
        {
          fields.map((field) => (
            <tr>
              <th scope="row">{field.name}</th>
              <td>{field.guidance}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
