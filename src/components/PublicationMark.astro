---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className } = Astro.props;
---

<a
  class:list={["publication-mark", className]}
  href={href}
  aria-label="Everyday Tech Insight home"
>
  <span class="publication-mark__initials" aria-hidden="true">ETI</span>
  <span class="publication-mark__name site-name">Everyday Tech Insight</span>
</a>

<style>
  .publication-mark {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .publication-mark__initials {
    display: grid;
    inline-size: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    border-inline-start: 0.375rem solid var(--color-accent, #d84a2f);
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .publication-mark__name {
    max-inline-size: 12ch;
    font-family: "Newsreader Variable", Georgia, serif;
    font-size: clamp(1.35rem, 1.1rem + 0.75vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 0.95;
  }
</style>
