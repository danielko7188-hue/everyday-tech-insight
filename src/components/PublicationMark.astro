---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className } = Astro.props;
---

<a
  class:list={["publication-mark", className]}
  href={href}
  aria-label="Everyday Tech Insight home"
>
  <span class="publication-mark__initials" aria-hidden="true">ETI</span>
  <span class="publication-mark__name site-name">Everyday Tech Insight</span>
</a>

<style>
  .publication-mark {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .publication-mark__initials {
    position: relative;
    display: grid;
    inline-size: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--brand-boundary, #756884);
    border-radius: 0.25rem;
    color: var(--brand-white, #ffffff);
    background: var(--brand-deep, #17102a);
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .publication-mark__initials::before {
    position: absolute;
    inset-block: 0.45rem;
    inset-inline-start: 0.3rem;
    inline-size: 0.2rem;
    border-radius: 99px;
    background: var(--brand-gradient);
    content: "";
  }

  .publication-mark__name {
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: clamp(1.35rem, 1.1rem + 0.75vw, 2rem);
    font-weight: 760;
    letter-spacing: -0.025em;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 21rem) {
    .publication-mark__name {
      display: none;
    }
  }
</style>
