---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className } = Astro.props;
---

<a
  class:list={["publication-mark", className]}
  href={href}
  aria-label="Everyday Tech Insight home"
>
  <span class="publication-mark__initials" aria-hidden="true">ETI</span>
  <span class="publication-mark__name site-name">Everyday Tech Insight</span>
</a>

<style>
  .publication-mark {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .publication-mark__initials {
    position: relative;
    display: grid;
    inline-size: 2rem;
    aspect-ratio: 1;
    place-items: center;
    border: 0;
    border-radius: 0.5rem;
    color: var(--brand-white, #ffffff);
    background: var(--brand-ink, #1d1d1f);
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.015em;
    line-height: 1;
  }

  .publication-mark__name {
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
