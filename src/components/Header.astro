---
import { categories, type CategorySlug } from "../data/categories";
import PublicationMark from "./PublicationMark.astro";

interface Props {
  currentPath?: string;
  activeCategory?: CategorySlug;
}

const { currentPath = Astro.url.pathname, activeCategory } = Astro.props;
const normalizePath = (path: string) =>
  path === "/" ? path : `${path.replace(/\/+$/, "")}/`;
const normalizedCurrentPath = normalizePath(currentPath);
const isCurrentPath = (path: string) =>
  normalizedCurrentPath === normalizePath(path);
const sectionCurrentState = (path: string) => {
  const normalizedPath = normalizePath(path);
  if (normalizedCurrentPath === normalizedPath) return "page";
  if (normalizedCurrentPath.startsWith(normalizedPath)) return "location";
  return undefined;
};
const categoryCurrentState = (slug: CategorySlug) => {
  if (isCurrentPath(`/categories/${slug}/`)) return "page";
  if (activeCategory === slug) return "location";
  return undefined;
};
---

<header class="site-header surface-dark">
  <div class="site-header__identity-row">
    <PublicationMark class="site-header__mark" />
    <nav class="site-header__utility" aria-label="Publication navigation">
      <ul>
        <li>
          <a href="/articles/" aria-current={sectionCurrentState("/articles/")}
            >Guides</a
          >
        </li>
        <li>
          <a href="/toolkit/" aria-current={sectionCurrentState("/toolkit/")}
            >Toolkit</a
          >
        </li>
        <li>
          <a
            href="/about/"
            aria-current={isCurrentPath("/about/") ? "page" : undefined}
            >About</a
          >
        </li>
      </ul>
    </nav>

    <details class="site-header__mobile-menu">
      <summary>
        <span class="site-header__menu-label">Menu</span>
        <span class="site-header__close-label">Close</span>
      </summary>
      <nav aria-label="Mobile navigation">
        <ul>
          <li>
            <a
              href="/articles/"
              aria-current={sectionCurrentState("/articles/")}>Guides</a
            >
          </li>
          <li>
            <a href="/toolkit/" aria-current={sectionCurrentState("/toolkit/")}
              >Toolkit</a
            >
          </li>
          <li>
            <a
              href="/about/"
              aria-current={isCurrentPath("/about/") ? "page" : undefined}
              >About</a
            >
          </li>
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/categories/${category.slug}/`}
                  aria-current={categoryCurrentState(category.slug)}
                >
                  {category.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>

  <nav class="site-header__topics" aria-label="Topic navigation">
    <ul>
      {
        categories.map((category) => (
          <li>
            <a
              href={`/categories/${category.slug}/`}
              aria-current={categoryCurrentState(category.slug)}
            >
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
