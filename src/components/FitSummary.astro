---
interface Props {
  businessProblem: string;
  technologyFocus: string;
  intendedAudience: string;
  deliverable: string;
  whenToUse: string;
}

const {
  businessProblem,
  technologyFocus,
  intendedAudience,
  deliverable,
  whenToUse,
} = Astro.props;
const fields = [
  ["Business problem", businessProblem],
  ["Technology focus", technologyFocus],
  ["Intended reader", intendedAudience],
  ["What you will produce", deliverable],
] as const;
---

<details class="fit-summary" aria-labelledby="fit-heading">
  <summary><h2 id="fit-heading">At a glance</h2></summary>
  <div class="fit-summary__content">
    <div class="fit-summary__when">
      <p class="fit-summary__when-label">When to use this guide</p>
      <p>{whenToUse}</p>
    </div>
    <dl>
      {
        fields.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</details>
