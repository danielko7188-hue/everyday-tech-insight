---
import { site } from "../data/site";
import {
  resolveAdUnit,
  type AdPlacement,
  type AdSurface,
} from "../utils/monetization";

interface Props {
  placement: AdPlacement;
  surface?: AdSurface;
  articleStatus?: "draft" | "review" | "published" | "archived";
  articleWordCount?: number;
  class?: string;
}

const {
  placement,
  surface = "article",
  articleStatus = "draft",
  articleWordCount = 0,
  class: className,
} = Astro.props;
const dimensions: Record<AdPlacement, { width: number; height: number }> = {
  "article-after-intro": { width: 728, height: 90 },
  "article-before-sources": { width: 728, height: 90 },
};
const { width, height } = dimensions[placement];
const adUnit = resolveAdUnit(site.integrations.monetization, {
  articleStatus,
  articleWordCount,
  placement,
  surface,
});
const reservedDimensions = `box-sizing: border-box; display: grid; inline-size: min(100%, ${width}px); min-block-size: ${height}px; place-items: center; border: 1px solid var(--color-rule, #c9c5ba); color: var(--color-muted, #59605e); background: var(--color-paper, #fffdf8);`;
---

{
  adUnit && (
    <aside
      class:list={["ad-slot", className]}
      aria-label="Advertisement"
      data-ad-placement={adUnit.placement}
      data-reserved-width={width}
      data-reserved-height={height}
      style={reservedDimensions}
    >
      <span>Advertisement</span>
      <ins
        class="adsbygoogle"
        aria-label="Advertisement"
        data-ad-client={adUnit.publisherId}
        data-ad-slot={adUnit.slotId}
        style={`display: block; inline-size: min(100%, ${width}px); min-block-size: ${height}px;`}
      />
    </aside>
  )
}
