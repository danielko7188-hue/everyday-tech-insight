---
import { categoryAccents, type CategorySlug } from "../data/categories";
import {
  EDITORIAL_VISUAL_KEYS,
  type ArticleVisual,
} from "../utils/content-contract";
import { visualVariantForSlug } from "../utils/presentation";

type VisualRatio = "wide" | "landscape" | "square";
type VisualFit = "cover" | "contain";

interface Props {
  category: CategorySlug;
  slug: string;
  visual?: ArticleVisual;
  ratio?: VisualRatio;
  fit?: VisualFit;
  sizeClass?: string;
  class?: string;
}

const {
  category,
  slug,
  visual,
  ratio = "landscape",
  fit = "contain",
  sizeClass,
  class: className,
} = Astro.props;

if (
  visual &&
  !EDITORIAL_VISUAL_KEYS.includes(
    visual.key as (typeof EDITORIAL_VISUAL_KEYS)[number],
  )
) {
  throw new Error(`Unknown informative editorial visual key: ${visual.key}`);
}

const aspectRatios: Record<VisualRatio, string> = {
  wide: "16 / 9",
  landscape: "3 / 2",
  square: "1 / 1",
};

const variant = visualVariantForSlug(slug, 4);
const horizontalShift = [0, 18, -14, 28][variant] ?? 0;
const verticalShift = [0, -12, 16, 8][variant] ?? 0;
const rotation = [0, 4, -5, 7][variant] ?? 0;
const accent = categoryAccents[category];
const visualStyle = `--editorial-accent: ${accent}; --editorial-ratio: ${aspectRatios[ratio]};`;
const preserveAspectRatio =
  visual || fit === "contain" ? "xMidYMid meet" : "xMidYMid slice";
const titleId = visual ? `editorial-visual-${visual.key}-title` : undefined;
const descriptionId = visual
  ? `editorial-visual-${visual.key}-description`
  : undefined;
const motifTransform: Record<CategorySlug, string> = {
  "ai-automation": `translate(${horizontalShift} ${verticalShift})`,
  "business-software": `translate(${horizontalShift} ${verticalShift}) rotate(${rotation} 360 240)`,
  "cybersecurity-data-protection": `translate(${horizontalShift / 2} ${verticalShift / 2})`,
  "digital-operations": `translate(${horizontalShift} ${verticalShift})`,
  "technology-strategy": `rotate(${rotation} 360 240)`,
};
---

{
  visual ? (
    <figure
      class="editorial-visual-figure"
      data-visual-key={visual.key}
      data-visual-type={visual.type}
    >
      <svg
        class:list={[
          "editorial-visual",
          `editorial-visual--${ratio}`,
          sizeClass,
          className,
        ]}
        style={visualStyle}
        viewBox="0 0 720 480"
        preserveAspectRatio={preserveAspectRatio}
        role="img"
        aria-labelledby={`${titleId} ${descriptionId}`}
        focusable="false"
        data-category={category}
        data-variant={variant}
        data-visual-key={visual.key}
        data-visual-type={visual.type}
      >
        <title id={titleId}>{visual.alt}</title>
        <desc id={descriptionId}>{visual.caption ?? visual.alt}</desc>
        <rect class="editorial-visual__paper" width="720" height="480" />
        <use href={`#${visual.key}`} />
      </svg>
      {visual.caption && (
        <figcaption class="editorial-visual__caption">
          {visual.caption}
        </figcaption>
      )}
    </figure>
  ) : (
    <svg
      class:list={[
        "editorial-visual",
        `editorial-visual--${ratio}`,
        sizeClass,
        className,
      ]}
      style={visualStyle}
      viewBox="0 0 720 480"
      preserveAspectRatio={preserveAspectRatio}
      aria-hidden="true"
      focusable="false"
      data-category={category}
      data-variant={variant}
    >
      <rect class="editorial-visual__paper" width="720" height="480" />
      <g transform={motifTransform[category]}>
        <use href={`#${category}`} />
      </g>
    </svg>
  )
}

<style>
  .editorial-visual {
    display: block;
    inline-size: 100%;
    aspect-ratio: var(--editorial-ratio);
    overflow: hidden;
    color: var(--editorial-accent);
    background: var(--brand-paper, #ffffff);
  }

  .editorial-visual-figure {
    min-inline-size: 0;
    margin: 0;
  }

  .editorial-visual__caption {
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    border-block-start: 1px solid var(--brand-rule-light, #d2d2d7);
    color: var(--brand-text-muted-light, #515154);
    font-size: 0.875rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .editorial-visual__paper {
    fill: var(--brand-paper, #ffffff);
  }
</style>
