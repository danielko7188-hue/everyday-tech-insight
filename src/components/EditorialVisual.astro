---
import { categoryAccents, type CategorySlug } from "../data/categories";
import { visualVariantForSlug } from "../utils/presentation";

type VisualRatio = "wide" | "landscape" | "square";
type VisualFit = "cover" | "contain";

interface Props {
  category: CategorySlug;
  slug: string;
  ratio?: VisualRatio;
  fit?: VisualFit;
  sizeClass?: string;
  class?: string;
}

const {
  category,
  slug,
  ratio = "landscape",
  fit = "cover",
  sizeClass,
  class: className,
} = Astro.props;

const aspectRatios: Record<VisualRatio, string> = {
  wide: "16 / 9",
  landscape: "3 / 2",
  square: "1 / 1",
};

const variant = visualVariantForSlug(slug, 4);
const horizontalShift = [0, 18, -14, 28][variant] ?? 0;
const verticalShift = [0, -12, 16, 8][variant] ?? 0;
const rotation = [0, 4, -5, 7][variant] ?? 0;
const accent = categoryAccents[category];
const visualStyle = `--editorial-accent: ${accent}; --editorial-ratio: ${aspectRatios[ratio]};`;
const preserveAspectRatio =
  fit === "contain" ? "xMidYMid meet" : "xMidYMid slice";
const motifTransform: Record<CategorySlug, string> = {
  "ai-automation": `translate(${horizontalShift} ${verticalShift})`,
  "business-software": `translate(${horizontalShift} ${verticalShift}) rotate(${rotation} 360 240)`,
  "cybersecurity-data-protection": `translate(${horizontalShift / 2} ${verticalShift / 2})`,
  "digital-operations": `translate(${horizontalShift} ${verticalShift})`,
  "technology-strategy": `rotate(${rotation} 360 240)`,
};
---

<svg
  class:list={[
    "editorial-visual",
    `editorial-visual--${ratio}`,
    sizeClass,
    className,
  ]}
  style={visualStyle}
  viewBox="0 0 720 480"
  preserveAspectRatio={preserveAspectRatio}
  aria-hidden="true"
  focusable="false"
  data-category={category}
  data-variant={variant}
>
  <rect class="editorial-visual__paper" width="720" height="480"></rect>
  <path class="editorial-visual__rule" d="M48 48H672M48 432H672"></path>
  <g transform={motifTransform[category]}>
    <use href={`#${category}`}></use>
  </g>
</svg>

<style>
  .editorial-visual {
    display: block;
    inline-size: 100%;
    aspect-ratio: var(--editorial-ratio);
    overflow: hidden;
    color: var(--editorial-accent);
    background: var(--color-paper, #fffdf8);
  }

  .editorial-visual__paper {
    fill: var(--color-paper, #fffdf8);
  }

  .editorial-visual__rule {
    vector-effect: non-scaling-stroke;
  }

  .editorial-visual__rule {
    fill: none;
    stroke: var(--color-rule, #c9c5ba);
    stroke-width: 2;
  }
</style>
