---
import { categoriesBySlug } from "../data/categories";
import {
  estimateReadingTime,
  resolveStoryDate,
  resolveStoryTreatment,
  type StoryDateMode,
  type StoryTreatment,
} from "../utils/presentation";
import type { PublishedArticleEntry } from "../utils/published-articles";
import EditorialVisual from "./EditorialVisual.astro";
import StoryMeta from "./StoryMeta.astro";

interface Props {
  article: PublishedArticleEntry;
  variant?: StoryTreatment;
  headingLevel?: 2 | 3;
  showVisual?: boolean;
  showFullMeta?: boolean;
  dateMode?: StoryDateMode;
}

const {
  article,
  variant = "standard",
  headingLevel = 2,
  showVisual: showVisualOverride,
  showFullMeta: showFullMetaOverride,
  dateMode = "published",
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const category = categoriesBySlug.get(article.data.category);

if (!category) {
  throw new Error(`Unknown article category: ${article.data.category}`);
}

const readingMinutes = estimateReadingTime(article.body ?? "");
const visualRatio = variant === "lead" ? "wide" : "landscape";
const treatment = resolveStoryTreatment(variant);
const showVisual = showVisualOverride ?? treatment.showVisual;
const showFullMeta = showFullMetaOverride ?? treatment.showFullMeta;
const showDate = showFullMeta || variant === "list";
const storyDate = resolveStoryDate(article.data, dateMode);
---

<article
  class:list={["article-card", `article-card--${variant}`]}
  data-category={category.slug}
  style={`--category-accent: ${category.accent};`}
>
  {
    showVisual && (
      <div class="article-card__visual" data-editorial-visual>
        <EditorialVisual
          category={category.slug}
          slug={article.data.slug}
          visual={article.data.visual}
          ratio={visualRatio}
        />
      </div>
    )
  }

  <div class="article-card__copy">
    <StoryMeta
      categoryName={category.name}
      categorySlug={category.slug}
      contentType={article.data.contentType}
      publicationDate={storyDate.date}
      dateLabel={storyDate.label}
      readingMinutes={readingMinutes}
      compact={treatment.compactMeta}
      showContentType={showFullMeta || variant !== "compact"}
      showDate={showDate}
    />
    <Heading class="article-card__title">
      <a href={`/articles/${article.data.slug}/`}>{article.data.title}</a>
    </Heading>
    {
      treatment.showPromise && (
        <p class="article-card__promise">{article.data.guidePromise}</p>
      )
    }
    {
      treatment.showDeliverable && (
        <p class="article-card__deliverable">
          <strong>What you will produce</strong>
          <span>{article.data.deliverable}</span>
        </p>
      )
    }
  </div>
</article>
