---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter(
  (heading) =>
    (heading.depth === 2 || heading.depth === 3) &&
    heading.slug.trim().length > 0,
);

interface HeadingGroup {
  heading: MarkdownHeading;
  children: MarkdownHeading[];
}

const groups: HeadingGroup[] = [];
let activeH2: HeadingGroup | undefined;

for (const heading of items) {
  if (heading.depth === 2) {
    activeH2 = { heading, children: [] };
    groups.push(activeH2);
  } else if (activeH2) {
    activeH2.children.push(heading);
  } else {
    groups.push({ heading, children: [] });
  }
}
---

{
  groups.length > 0 && (
    <nav class="table-of-contents" aria-label="On this page">
      <p aria-hidden="true">On this page</p>
      <ol>
        {groups.map(({ heading, children }) => (
          <li class={`table-of-contents__depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
            {children.length > 0 && (
              <ol class="table-of-contents__sublist">
                {children.map((child) => (
                  <li class="table-of-contents__depth-3">
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
