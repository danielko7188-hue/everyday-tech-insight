---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}

const { eyebrow, title, description, href, linkLabel, id } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading__copy">
    {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
  {
    href && linkLabel && (
      <a class="section-heading__link" href={href}>
        {linkLabel}
        <span aria-hidden="true"> →</span>
      </a>
    )
  }
</header>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    align-items: end;
    padding-block-end: 1rem;
    border-block-end: 0;
  }

  .section-heading__copy > * {
    margin: 0;
  }

  .section-heading__eyebrow {
    margin-block-end: 0.5rem;
    color: var(--color-muted, #515154);
    font-family: "Source Sans 3 Variable", "Segoe UI", sans-serif;
    font-size: 0.875rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-inline-size: 24ch;
    color: var(--brand-ink, #1d1d1f);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.35rem + 1.35vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .section-heading__description {
    max-inline-size: 62ch;
    margin-block-start: 0.5rem;
    color: var(--brand-text-muted-light, #515154);
  }

  .section-heading__link {
    color: var(--brand-accent, #0066cc);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 35rem) {
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
