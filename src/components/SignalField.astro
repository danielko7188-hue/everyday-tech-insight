---
interface Props {
  variant?: "hero" | "compact";
}

const { variant = "hero" } = Astro.props;
---

<div
  class:list={["signal-field", `signal-field--${variant}`]}
  data-signal-field={variant}
  aria-hidden="true"
>
  <svg viewBox="0 0 640 360" focusable="false">
    <g
      class="signal-field__plane signal-field__plane--rear"
      data-signal-plane="rear"
    >
      <path d="M42 92H196L238 50H402L448 96H598"></path>
      <path d="M72 284H206L254 236H402L454 288H574"></path>
      <circle cx="42" cy="92" r="5"></circle>
      <circle cx="598" cy="96" r="5"></circle>
      <circle cx="72" cy="284" r="5"></circle>
      <circle cx="574" cy="288" r="5"></circle>
    </g>
    <g
      class="signal-field__plane signal-field__plane--middle"
      data-signal-plane="middle"
    >
      <rect x="116" y="130" width="132" height="84" rx="12"></rect>
      <rect x="392" y="130" width="132" height="84" rx="12"></rect>
      <path d="M248 172H392"></path>
      <circle cx="320" cy="172" r="11"></circle>
    </g>
    <g
      class="signal-field__plane signal-field__plane--front"
      data-signal-plane="front"
    >
      <path d="M182 130L248 82H392L458 130"></path>
      <path d="M182 214L248 262H392L458 214"></path>
      <circle cx="248" cy="82" r="7"></circle>
      <circle cx="392" cy="82" r="7"></circle>
      <circle cx="248" cy="262" r="7"></circle>
      <circle cx="392" cy="262" r="7"></circle>
    </g>
  </svg>
</div>
