---
import { categories } from "../data/categories";
import { site } from "../data/site";
import PublicationMark from "./PublicationMark.astro";
---

<footer class="site-footer surface-dark">
  <div class="site-footer__intro">
    <PublicationMark class="site-footer__mark" />
    <p>{site.tagline}</p>
  </div>

  <div class="site-footer__groups">
    <nav aria-labelledby="footer-publication-heading">
      <h2 id="footer-publication-heading">Publication</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/publisher/">Publisher</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-guides-heading">
      <h2 id="footer-guides-heading">Guides</h2>
      <ul>
        <li><a href="/articles/">All guides</a></li>
        <li><a href="/toolkit/">Toolkit</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-topics-heading">
      <h2 id="footer-topics-heading">Topics</h2>
      <ul>
        {
          categories.map((category) => (
            <li>
              <a href={`/categories/${category.slug}/`}>{category.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-standards-heading">
      <h2 id="footer-standards-heading">Standards &amp; transparency</h2>
      <ul>
        <li><a href="/editorial-standards/">Editorial standards</a></li>
        <li><a href="/corrections/">Corrections</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-privacy-heading">
      <h2 id="footer-privacy-heading">Privacy &amp; advertising</h2>
      <ul>
        <li><a href="/privacy/">Privacy</a></li>
        <li>
          <a href="/advertising-disclosure/">Advertising disclosure</a>
        </li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-feeds-heading">
      <h2 id="footer-feeds-heading">Sitemap &amp; RSS</h2>
      <ul>
        <li><a href="/sitemap/">Sitemap</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>
