---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { CategorySlug } from "../data/categories";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  canonical?: string;
  robots?: "index,follow" | "noindex,follow";
  ogType?: "website" | "article";
  activeCategory?: CategorySlug;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  canonical: canonicalOverride,
  robots = "index,follow",
  ogType = "website",
  activeCategory,
  structuredData = [],
} = Astro.props;

const canonical = new URL(canonicalOverride ?? path, site.url).toString();
const jsonLdItems = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      jsonLdItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item).replaceAll("<", "\\u003c")}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={path} activeCategory={activeCategory} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
