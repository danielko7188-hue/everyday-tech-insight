---
import type { MarkdownHeading } from "astro";

import ArticleCard from "../components/ArticleCard.astro";
import ArticleEvidence from "../components/ArticleEvidence.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EditorialVisual from "../components/EditorialVisual.astro";
import FitSummary from "../components/FitSummary.astro";
import GuidePreparation from "../components/GuidePreparation.astro";
import SourceList from "../components/SourceList.astro";
import StoryMeta from "../components/StoryMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { CategoryRecord } from "../data/categories";
import { site } from "../data/site";
import { getToolkitResourceForArticle } from "../data/toolkit";
import { resolveManagedArticleHeroImage } from "../utils/managed-article-images.mjs";
import { formatPublicationDate } from "../utils/presentation";
import type { PublishedArticleEntry } from "../utils/published-articles";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  article: PublishedArticleEntry;
  category: CategoryRecord;
  headings: MarkdownHeading[];
  readingMinutes: number;
  relatedArticles?: PublishedArticleEntry[];
}

const {
  article,
  category,
  headings,
  readingMinutes,
  relatedArticles = [],
} = Astro.props;
const { data } = article;
const articlePath = `/articles/${data.slug}/`;
const toolkitResource = getToolkitResourceForArticle(data.slug);
const managedHeroImage = await resolveManagedArticleHeroImage(data, {
  repositoryRoot: process.cwd(),
});
const title = `${data.title} | ${site.name}`;
const formatDate = (date: string) =>
  formatPublicationDate(date, {
    timeZone: site.timeZone,
    locale: site.locale,
  });
---

<BaseLayout
  title={title}
  description={data.description}
  path={articlePath}
  ogType="article"
  articlePublishedTime={data.datePublished}
  articleModifiedTime={data.dateModified}
  articleSection={category.name}
  socialImagePath={`/social/article-${data.slug}.png`}
  socialImageAlt={`Social preview for “${data.title}” in ${category.name}.`}
  activeCategory={category.slug}
  editorialVisualSymbolIds={[data.visual.key]}
>
  <div class="page-shell article-shell">
    <Breadcrumbs
      compactCurrent
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: `/categories/${category.slug}/` },
        { name: data.title, href: articlePath },
      ]}
    />

    <article class="article-page">
      <header
        class="article-hero"
        data-category={category.slug}
        style={`--category-accent: ${category.accent};`}
      >
        <div class="article-hero__copy">
          <StoryMeta
            categoryName={category.name}
            categorySlug={category.slug}
            contentType={data.contentType}
            publicationDate={data.datePublished}
            readingMinutes={readingMinutes}
          />
          <h1>{data.title}</h1>
          <p class="article-summary">{data.guidePromise}</p>
          <div class="article-facts">
            <p>
              By <strong><a href="/publisher/">{data.author}</a></strong>
            </p>
            <p>
              Published <time datetime={data.datePublished}
                >{formatDate(data.datePublished)}</time
              >
            </p>
            {
              data.dateModified && data.dateModified !== data.datePublished && (
                <p>
                  Updated{" "}
                  <time datetime={data.dateModified}>
                    {formatDate(data.dateModified)}
                  </time>
                </p>
              )
            }
          </div>
          <ArticleEvidence
            sourceCount={data.sourceList.length}
            reviewedDate={data.lastReviewed}
            reviewedLabel={data.lastReviewed
              ? formatDate(data.lastReviewed)
              : undefined}
          />
        </div>
        <div
          class="article-hero__visual"
          data-editorial-visual={managedHeroImage ? undefined : true}
          data-managed-hero-image={managedHeroImage ? true : undefined}
        >
          {
            managedHeroImage ? (
              <figure class="article-hero-image">
                <img
                  src={managedHeroImage.publicUrl}
                  alt={managedHeroImage.alt}
                  aria-hidden={managedHeroImage.decorative ? "true" : undefined}
                  width={managedHeroImage.width}
                  height={managedHeroImage.height}
                  loading="eager"
                  decoding="async"
                />
                {(managedHeroImage.caption ||
                  managedHeroImage.credit ||
                  managedHeroImage.license) && (
                  <figcaption>
                    {managedHeroImage.caption && (
                      <span>{managedHeroImage.caption}</span>
                    )}
                    {managedHeroImage.credit && (
                      <span>
                        Image credit:{" "}
                        {managedHeroImage.sourceUrl ? (
                          <a href={managedHeroImage.sourceUrl}>
                            {managedHeroImage.credit}
                          </a>
                        ) : (
                          managedHeroImage.credit
                        )}
                      </span>
                    )}
                    {managedHeroImage.license && (
                      <span>License: {managedHeroImage.license}</span>
                    )}
                  </figcaption>
                )}
              </figure>
            ) : (
              <EditorialVisual
                category={category.slug}
                slug={data.slug}
                visual={data.visual}
                ratio="wide"
              />
            )
          }
        </div>
      </header>

      <FitSummary
        businessProblem={data.businessProblem}
        technologyFocus={data.technologyFocus}
        intendedAudience={data.intendedAudience}
        deliverable={data.deliverable}
        whenToUse={data.whenToUse}
      />

      <div class="article-reading-layout">
        <aside class="article-reading-layout__toc">
          <TableOfContents headings={headings} />
        </aside>

        <div class="article-reading-layout__content">
          <div class="article-body">
            <slot />
          </div>

          {
            toolkitResource && (
              <aside
                class="article-toolkit-callout"
                aria-labelledby={`article-toolkit-${toolkitResource.id}`}
              >
                <p class="eyebrow">Toolkit worksheet</p>
                <h2 id={`article-toolkit-${toolkitResource.id}`}>
                  {toolkitResource.title}
                </h2>
                <p>
                  This worksheet helps produce a bounded working record for the
                  decision in this guide.
                </p>
                <p class="article-toolkit-callout__outcome">
                  <strong>Record produced:</strong> {toolkitResource.outcome}
                </p>
                <p class="article-toolkit-callout__action">
                  <a href={toolkitResource.detailHref}>
                    Open the worksheet guide
                  </a>
                </p>
              </aside>
            )
          }

          <GuidePreparation sources={data.sourceList} />

          <SourceList sources={data.sourceList} />
        </div>
      </div>

      <section class="notice byline-notice" aria-labelledby="byline-heading">
        <h2 id="byline-heading">About the publication byline</h2>
        <p>
          Everyday Tech Insight is a publication-name byline, not an identified
          person or legal organization; the name never represents a person.
        </p>
        <p>
          <a href="/contact/">Contact</a> · <a href="/corrections/"
            >Corrections</a
          >
        </p>
      </section>

      {
        relatedArticles.length > 0 && (
          <section class="related-articles" aria-labelledby="related-heading">
            <h2 id="related-heading">Related reading</h2>
            <p>
              These explicitly related guides extend the workflow, evaluation,
              or control decisions discussed in this article.
            </p>
            <ul class="related-articles__list">
              {relatedArticles.map((related) => (
                <li>
                  <ArticleCard
                    article={related}
                    variant="list"
                    headingLevel={3}
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="article-footer">
        <p>
          Found a factual error or a source that needs review?{" "}
          <a href="/corrections/">Request a correction</a>.
        </p>
      </footer>
    </article>
  </div>
</BaseLayout>
