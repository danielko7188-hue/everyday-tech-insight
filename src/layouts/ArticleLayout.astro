---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import ArticleCard from "../components/ArticleCard.astro";
import ArticleEvidence from "../components/ArticleEvidence.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EditorialVisual from "../components/EditorialVisual.astro";
import FitSummary from "../components/FitSummary.astro";
import SourceList from "../components/SourceList.astro";
import StoryMeta from "../components/StoryMeta.astro";
import TableOfContents from "../components/TableOfContents.astro";
import type { CategoryRecord } from "../data/categories";
import { site } from "../data/site";
import { formatPublicationDate } from "../utils/presentation";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  article: CollectionEntry<"articles">;
  category: CategoryRecord;
  headings: MarkdownHeading[];
  readingMinutes: number;
  relatedArticles?: CollectionEntry<"articles">[];
}

const {
  article,
  category,
  headings,
  readingMinutes,
  relatedArticles = [],
} = Astro.props;
const { data } = article;
const articlePath = `/articles/${data.slug}/`;
const title = `${data.title} | ${site.name}`;
const formatDate = (date: string) =>
  formatPublicationDate(date, {
    timeZone: site.timeZone,
    locale: site.locale,
  });
---

<BaseLayout
  title={title}
  description={data.description}
  path={articlePath}
  canonical={data.canonicalOverride}
  ogType="article"
  articlePublishedTime={data.datePublished}
  articleModifiedTime={data.dateModified}
  articleSection={category.name}
  activeCategory={category.slug}
  includeEditorialVisualSymbols
>
  <div class="page-shell article-shell">
    <Breadcrumbs
      compactCurrent
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: `/categories/${category.slug}/` },
        { name: data.title, href: articlePath },
      ]}
    />

    <article class="article-page">
      <header
        class="article-hero"
        data-category={category.slug}
        style={`--category-accent: ${category.accent};`}
      >
        <div class="article-hero__copy">
          <StoryMeta
            categoryName={category.name}
            categorySlug={category.slug}
            contentType={data.contentType}
            publicationDate={data.datePublished}
            readingMinutes={readingMinutes}
          />
          <h1>{data.title}</h1>
          <p class="article-summary">{data.summary}</p>
          <div class="article-facts">
            <p>
              By <strong><a href="/publisher/">{data.author}</a></strong>
            </p>
            <p>
              Published <time datetime={data.datePublished}
                >{formatDate(data.datePublished)}</time
              >
            </p>
            {
              data.dateModified && data.dateModified !== data.datePublished && (
                <p>
                  Updated{" "}
                  <time datetime={data.dateModified}>
                    {formatDate(data.dateModified)}
                  </time>
                </p>
              )
            }
          </div>
          <ArticleEvidence
            sourceCount={data.sourceList.length}
            reviewedDate={data.lastReviewed}
            reviewedLabel={formatDate(data.lastReviewed)}
          />
        </div>
        <div class="article-hero__visual" data-editorial-visual>
          <EditorialVisual
            category={category.slug}
            slug={data.slug}
            visual={data.visual}
            ratio="wide"
          />
        </div>
      </header>

      <FitSummary
        businessProblem={data.businessProblem}
        technologyFocus={data.technologyFocus}
        intendedAudience={data.intendedAudience}
        readerOutcome={data.readerOutcome}
      />

      <div class="article-reading-layout">
        <aside class="article-reading-layout__toc">
          <TableOfContents headings={headings} />
        </aside>

        <div class="article-reading-layout__content">
          <div class="article-body">
            <slot />
          </div>

          <SourceList sources={data.sourceList} />
        </div>
      </div>

      <section class="notice byline-notice" aria-labelledby="byline-heading">
        <h2 id="byline-heading">About the publication byline</h2>
        <p>
          <a href="/publisher/"><strong>{data.author}</strong></a> is a publication-name
          byline, not a named person, legal entity, team, credential, or claim of
          hands-on product testing.
        </p>
        <p>
          <a href="/contact/">Contact</a> · <a href="/corrections/"
            >Corrections</a
          >
        </p>
      </section>

      {
        relatedArticles.length > 0 && (
          <section class="related-articles" aria-labelledby="related-heading">
            <h2 id="related-heading">Related reading</h2>
            <p>
              These explicitly related guides extend the workflow, evaluation,
              or control decisions discussed in this article.
            </p>
            <ul class="related-articles__list">
              {relatedArticles.map((related) => (
                <li>
                  <ArticleCard
                    article={related}
                    variant="list"
                    headingLevel={3}
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="article-footer">
        <p>
          Found a factual error or a source that needs review?{" "}
          <a href="/corrections/">Request a correction</a>.
        </p>
      </footer>
    </article>
  </div>
</BaseLayout>
