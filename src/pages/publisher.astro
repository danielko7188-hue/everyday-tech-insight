---
import { getCollection } from "astro:content";

import { trustPages } from "../data/trust-pages";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import { filterPublishedArticles } from "../utils/published-articles";

const publishedArticles = filterPublishedArticles(
  await getCollection("articles"),
).sort((left, right) => {
  const dateOrder = right.data.datePublished.localeCompare(
    left.data.datePublished,
  );
  return dateOrder || left.data.title.localeCompare(right.data.title);
});
const page = trustPages.publisher;
---

<TrustPageLayout page={page} currentKey="publisher">
  <p class="publisher-purpose">
    Everyday Tech Insight publishes practical guidance for small-business
    decision makers who select, manage, secure, or govern technology without a
    large specialist team. Its guides connect business problems with practical
    technology decisions.
  </p>
  <section aria-labelledby="published-articles-heading">
    <h2 id="published-articles-heading">Published articles</h2>
    <p>
      Explore practical decisions across business software, AI and automation,
      cybersecurity, digital operations, and technology strategy.
    </p>
    <ul>
      {
        publishedArticles.map((article) => (
          <li>
            <a href={`/articles/${article.data.slug}/`}>{article.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
  <section aria-labelledby="publisher-identity-boundary-heading">
    <h2 id="publisher-identity-boundary-heading">The publication byline</h2>
    <p>
      Articles carry <strong>Everyday Tech Insight</strong> as their publication-name
      byline. It identifies this collection of source-backed guides rather than a
      named author.
    </p>
    <p>
      The guides explain their source material, practical method, and limits.
      They do not report first-hand product testing. The <a
        href="/editorial-standards/">editorial standards</a
      > explain AI assistance and the current human-review limitations.
    </p>
    <p>
      Questions about a guide, an accessibility problem, or a factual error can
      be raised through <a href="/contact/">Contact</a> or the <a
        href="/corrections/">corrections process</a
      >.
    </p>
    <p class="notice">
      Use each guide as a starting point for a decision in your own business.
      Source-backed guidance does not replace the testing or specialist advice
      your situation may require.
    </p>
  </section>
</TrustPageLayout>
