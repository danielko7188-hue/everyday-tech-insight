---
import { getCollection } from "astro:content";

import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const publishedArticles = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort((left, right) => {
  const dateOrder = right.data.datePublished.localeCompare(
    left.data.datePublished,
  );
  return dateOrder || left.data.title.localeCompare(right.data.title);
});
const title = `Publisher identity boundary | ${site.name}`;
const description =
  "A plain statement of the verified public publisher identity and the personal, legal, credential, team, and testing claims not made by this publication.";
---

<BaseLayout title={title} description={description} path="/publisher/">
  <div class="page-shell">
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Publisher", href: "/publisher/" },
      ]}
    />
    <article class="trust-content">
      <p class="eyebrow">Identity and evidence</p>
      <h1>Publisher</h1>
      <p class="page-deck">
        Everyday Tech Insight is the publication name, not a legal entity or a
        claim about a particular person.
      </p>
      <p>
        This page does not claim a named person, company, team, professional
        credentials, business registration, office, or hands-on product testing.
        Those facts have not been supplied and verified for public use.
      </p>
      <p>
        Articles therefore use <strong>Everyday Tech Insight</strong> only as a publication-name
        byline. The byline is not presented as a person or organization in structured
        data.
      </p>
      <p class="notice">
        Reader trust depends on accurate boundaries. A future identity update
        should be published only after the relevant facts and permission to
        share them are confirmed.
      </p>
      <section aria-labelledby="published-articles-heading">
        <h2 id="published-articles-heading">Published articles</h2>
        <p>
          This index is generated from entries that currently have published
          status. Draft and review entries do not appear.
        </p>
        <ul>
          {
            publishedArticles.map((article) => (
              <li>
                <a href={`/articles/${article.data.slug}/`}>
                  {article.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>
