---
import { getCollection } from "astro:content";

import { trustPages } from "../data/trust-pages";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import { filterPublishedArticles } from "../utils/published-articles";

const publishedArticles = filterPublishedArticles(
  await getCollection("articles"),
).sort((left, right) => {
  const dateOrder = right.data.datePublished.localeCompare(
    left.data.datePublished,
  );
  return dateOrder || left.data.title.localeCompare(right.data.title);
});
const page = trustPages.publisher;
---

<TrustPageLayout page={page} currentKey="publisher">
  <p class="publisher-purpose">
    Everyday Tech Insight publishes practical guidance for small-business
    decision makers who select, manage, secure, or govern technology without a
    large specialist team. Its guides connect business problems with practical
    technology decisions.
  </p>
  <section aria-labelledby="published-articles-heading">
    <h2 id="published-articles-heading">Published articles</h2>
    <p>
      This index is generated from entries that currently have published status.
      Draft and review entries do not appear.
    </p>
    <ul>
      {
        publishedArticles.map((article) => (
          <li>
            <a href={`/articles/${article.data.slug}/`}>{article.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
  <section aria-labelledby="publisher-identity-boundary-heading">
    <h2 id="publisher-identity-boundary-heading">
      Publication identity boundary
    </h2>
    <p>
      Everyday Tech Insight is the publication name, not a legal entity or a
      claim about a particular person.
    </p>
    <p>
      This page does not claim a named person, company, team, professional
      credentials, business registration, office, or hands-on product testing.
      Those facts have not been supplied and verified for public use.
    </p>
    <p>
      Articles therefore use <strong>Everyday Tech Insight</strong> only as a publication-name
      byline. The byline is not presented as a person or organization in structured
      data.
    </p>
    <p class="notice">
      Reader trust depends on accurate boundaries. A future identity update
      should be published only after the relevant facts and permission to share
      them are confirmed.
    </p>
  </section>
</TrustPageLayout>
