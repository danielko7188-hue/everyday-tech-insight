---
import { getCollection } from "astro:content";

import { toolkitResourceHasPublishedGuide } from "../../data/editorial";
import { toolkitResources, type ToolkitResource } from "../../data/toolkit";
import ToolkitDetailLayout from "../../layouts/ToolkitDetailLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return toolkitResources.map((resource) => ({
    params: { slug: resource.id },
    props: {
      resource,
      showGuideLink: toolkitResourceHasPublishedGuide(resource, articles),
    },
  }));
}

interface Props {
  resource: ToolkitResource;
  showGuideLink: boolean;
}

const { resource, showGuideLink } = Astro.props;
---

<ToolkitDetailLayout resource={resource} showGuideLink={showGuideLink} />
