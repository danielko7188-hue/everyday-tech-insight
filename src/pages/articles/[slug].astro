---
import { getCollection, render } from "astro:content";

import { categoriesBySlug, type CategoryRecord } from "../../data/categories";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { estimateReadingTime } from "../../utils/presentation";
import {
  filterPublishedArticles,
  type PublishedArticleEntry,
} from "../../utils/published-articles";

export async function getStaticPaths() {
  const publishedArticles = filterPublishedArticles(
    await getCollection("articles"),
  );

  return publishedArticles.map((article) => ({
    params: { slug: article.data.slug },
    props: {
      article,
      relatedArticles: article.data.relatedArticles
        .map((slug) =>
          publishedArticles.find((candidate) => candidate.data.slug === slug),
        )
        .filter(
          (candidate): candidate is PublishedArticleEntry =>
            candidate !== undefined,
        ),
    },
  }));
}

interface Props {
  article: PublishedArticleEntry;
  relatedArticles: PublishedArticleEntry[];
}

const { article, relatedArticles } = Astro.props as Props;
const category = categoriesBySlug.get(article.data.category) as
  CategoryRecord | undefined;

if (!category) {
  throw new Error(`Unknown article category: ${article.data.category}`);
}

const { Content, headings } = await render(article);
const readingMinutes = estimateReadingTime(article.body ?? "");
---

<ArticleLayout
  article={article}
  category={category}
  headings={headings}
  readingMinutes={readingMinutes}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
