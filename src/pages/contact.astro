---
import { site } from "../data/site";
import { trustPages } from "../data/trust-pages";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";

const page = trustPages.contact;
---

<TrustPageLayout page={page} currentKey="contact">
  <p>
    <a href={site.contact.url}
      >Open the Everyday Tech Insight GitHub issues page</a
    > to send an editorial question or report a problem. A GitHub account is required
    to open an issue. For factual changes, see the <a href="/corrections/"
      >corrections process</a
    >
    {" "}
    first.
  </p>
  <h2>What to include</h2>
  <p>
    Share the page address, a short description, and the result you expected.
    For a display or accessibility problem, include your browser and device type
    when relevant. For a factual concern, include the passage and a supporting
    source if available.
  </p>
  <p class="notice">
    The issue tracker is public. Do not post private information, passwords,
    tokens, account records, payment details, or confidential business data.
  </p>
  <p>
    This is a public editorial contact channel. It is not a private support
    service or an emergency incident-response channel. For an active account,
    payment, or security incident, contact the responsible provider through a
    trusted channel.
  </p>
</TrustPageLayout>
