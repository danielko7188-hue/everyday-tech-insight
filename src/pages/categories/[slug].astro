---
import { getCollection } from "astro:content";

import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { categories, type CategoryRecord } from "../../data/categories";
import { partitionCategoryEdition } from "../../data/editorial";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  filterPublishedArticles,
  formatGuideCount,
  type PublishedArticleEntry,
} from "../../utils/published-articles";

export async function getStaticPaths() {
  const publishedArticles = filterPublishedArticles(
    await getCollection("articles"),
  );

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      articles: publishedArticles.filter(
        ({ data }) => data.category === category.slug,
      ),
    },
  }));
}

interface Props {
  category: CategoryRecord;
  articles: PublishedArticleEntry[];
}

const { category, articles } = Astro.props;
const categoryEdition = partitionCategoryEdition(articles);
const archiveOpeningLabel =
  categoryEdition.layout === "archive"
    ? categoryEdition.featured.every(({ data }) => data.featured === true)
      ? "Featured guides"
      : categoryEdition.featured.some(({ data }) => data.featured === true)
        ? "Featured and latest guides"
        : "Latest guides"
    : "";
const path = `/categories/${category.slug}/`;
const title = `${category.name} for small business | ${site.name}`;
const description = category.description;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  socialImagePath={`/social/category-${category.slug}.png`}
  socialImageAlt={`Social preview for the ${category.name} topic.`}
  activeCategory={category.slug}
>
  <div
    class="page-shell category-page"
    data-guide-count={articles.length}
    data-layout={categoryEdition.layout}
  >
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: path },
      ]}
    />

    <header
      class="category-hero"
      data-category={category.slug}
      style={`--category-accent: ${category.accent};`}
    >
      <div class="category-hero__copy">
        <h1>{category.name}</h1>
        <p class="page-deck">{category.description}</p>
      </div>
    </header>

    {
      categoryEdition.layout === "compact" ? (
        categoryEdition.articles.length > 0 ? (
          <section
            class="category-compact"
            aria-labelledby="category-compact-heading"
          >
            <h2 class="category-compact__heading" id="category-compact-heading">
              {formatGuideCount(categoryEdition.articles.length)} in this topic
            </h2>
            <ol class="category-compact__list">
              {categoryEdition.articles.map((article, index) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant={index === 0 ? "lead" : "compact"}
                    headingLevel={3}
                    showVisual={false}
                    showFullMeta={true}
                    cover={index === 0}
                    hideCategory
                  />
                </li>
              ))}
            </ol>
          </section>
        ) : (
          <section class="empty-category" aria-labelledby="scope-heading">
            <h2 id="scope-heading">Current scope</h2>
            <p>
              There are no guides in this topic yet.{" "}
              <a href="/articles/">Browse all guides</a> for related guidance.
            </p>
          </section>
        )
      ) : categoryEdition.layout === "editorial" ? (
        <section
          class="category-editorial"
          aria-labelledby="category-editorial-heading"
        >
          <SectionHeading
            eyebrow="Published guidance"
            title="A guided topic edition"
            description={`Explore ${formatGuideCount(articles.length)} with clear steps, useful decision tools, and limitations to consider.`}
            id="category-editorial-heading"
          />
          <div
            class="category-editorial__lead"
            aria-labelledby="category-lead-label"
          >
            <p class="eyebrow" id="category-lead-label">
              {categoryEdition.lead.data.featured
                ? "Featured lead guide"
                : "Latest guide"}
            </p>
            <ArticleCard
              article={categoryEdition.lead}
              variant="lead"
              headingLevel={3}
              showVisual={false}
              showFullMeta={true}
              hideCategory
            />
          </div>
          <p class="eyebrow" id="category-supporting-label">
            Supporting guides
          </p>
          <ol
            class="category-editorial__features"
            aria-labelledby="category-supporting-label"
          >
            {categoryEdition.features.map((article) => (
              <li>
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                  showVisual={false}
                  showFullMeta={true}
                  hideCategory
                />
              </li>
            ))}
          </ol>
          {categoryEdition.remainder.length > 0 && (
            <ol class="category-editorial__remainder">
              {categoryEdition.remainder.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="list"
                    headingLevel={3}
                    showVisual={false}
                    showFullMeta={true}
                    hideCategory
                  />
                </li>
              ))}
            </ol>
          )}
        </section>
      ) : (
        <section
          class="category-archive"
          aria-labelledby="category-archive-heading"
        >
          <SectionHeading
            eyebrow="Complete topic archive"
            title="Browse the full topic collection"
            description={`Browse ${formatGuideCount(articles.length)} and find the guidance that fits your next decision.`}
            id="category-archive-heading"
          />
          {categoryEdition.featured.length > 0 && (
            <>
              <p class="eyebrow" id="category-featured-label">
                {archiveOpeningLabel}
              </p>
              <ol
                class="category-archive__featured"
                aria-labelledby="category-featured-label"
              >
                {categoryEdition.featured.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="feature"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                      hideCategory
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
          {categoryEdition.recent.length > 0 && (
            <>
              <p class="eyebrow" id="category-recent-label">
                Recent guides
              </p>
              <ol
                class="category-archive__recent"
                aria-labelledby="category-recent-label"
              >
                {categoryEdition.recent.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="compact"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                      hideCategory
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
          {categoryEdition.archive.length > 0 && (
            <>
              <p class="eyebrow" id="category-archive-label">
                More guides
              </p>
              <ol
                class="category-archive__remainder"
                aria-labelledby="category-archive-label"
              >
                {categoryEdition.archive.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="list"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                      hideCategory
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>
