---
import { getCollection } from "astro:content";

import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialVisual from "../../components/EditorialVisual.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import {
  categories,
  type CategoryRecord,
  type CategorySlug,
} from "../../data/categories";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  filterPublishedArticles,
  type PublishedArticleEntry,
} from "../../utils/published-articles";

const categoryPurposes: Record<CategorySlug, string> = {
  "ai-automation":
    "Use this section to decide where automation can remove repeat work without hiding judgment, accountability, or operational risk.",
  "business-software":
    "Use this section to compare software against real workflows, ownership cost, data portability, and the effort required to change later.",
  "cybersecurity-data-protection":
    "Use this section to turn broad security concerns into prioritized safeguards for accounts, devices, vendors, and business data.",
  "digital-operations":
    "Use this section to make routine digital work easier to hand off, verify, recover, and improve as the business changes.",
  "technology-strategy":
    "Use this section to connect technology spending and governance to business priorities, constraints, and measurable decisions.",
};

export async function getStaticPaths() {
  const publishedArticles = filterPublishedArticles(
    await getCollection("articles"),
  );

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      articles: publishedArticles
        .filter(({ data }) => data.category === category.slug)
        .sort((left, right) => left.id.localeCompare(right.id, "en")),
    },
  }));
}

interface Props {
  category: CategoryRecord;
  articles: PublishedArticleEntry[];
}

const { category, articles } = Astro.props;
const path = `/categories/${category.slug}/`;
const title = `${category.name} for small business | ${site.name}`;
const description = category.description;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  socialImagePath={`/social/category-${category.slug}.png`}
  socialImageAlt={`Social preview for the ${category.name} topic.`}
  activeCategory={category.slug}
  editorialVisualSymbolIds={[category.slug]}
>
  <div
    class="page-shell category-page"
    data-guide-count={articles.length}
    data-layout="compact"
  >
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: path },
      ]}
    />

    <header
      class="category-hero"
      data-category={category.slug}
      style={`--category-accent: ${category.accent};`}
    >
      <div class="category-hero__copy">
        <p class="eyebrow">Business technology topic</p>
        <h1>{category.name}</h1>
        <p class="page-deck">{category.description}</p>
        <p>{categoryPurposes[category.slug]}</p>
      </div>
      <div class="category-hero__visual" data-editorial-visual>
        <EditorialVisual
          category={category.slug}
          slug={`${category.slug}-category`}
          ratio="wide"
          fit="contain"
        />
      </div>
    </header>

    <section
      class="category-compact"
      aria-labelledby="category-compact-heading"
    >
      <SectionHeading
        eyebrow="Published guidance"
        title="All guides in this topic"
        description={`All ${articles.length} published ${category.name} guides appear once in a neutral reading order.`}
        id="category-compact-heading"
      />
      <ol class="category-compact__list">
        {
          articles.map((article) => (
            <li>
              <ArticleCard
                article={article}
                variant="compact"
                headingLevel={3}
                showVisual={false}
                showFullMeta={true}
              />
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
