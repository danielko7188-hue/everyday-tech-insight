---
import { getCollection } from "astro:content";

import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialVisual from "../../components/EditorialVisual.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import {
  categories,
  type CategoryRecord,
  type CategorySlug,
} from "../../data/categories";
import { partitionCategoryEdition } from "../../data/editorial";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  filterPublishedArticles,
  formatGuideCount,
  type PublishedArticleEntry,
} from "../../utils/published-articles";

const categoryPurposes: Record<CategorySlug, string> = {
  "ai-automation":
    "Use this section to decide where automation can remove repeat work without hiding judgment, accountability, or operational risk.",
  "business-software":
    "Use this section to compare software against real workflows, ownership cost, data portability, and the effort required to change later.",
  "cybersecurity-data-protection":
    "Use this section to turn broad security concerns into prioritized safeguards for accounts, devices, vendors, and business data.",
  "digital-operations":
    "Use this section to make routine digital work easier to hand off, verify, recover, and improve as the business changes.",
  "technology-strategy":
    "Use this section to connect technology spending and governance to business priorities, constraints, and measurable decisions.",
};

export async function getStaticPaths() {
  const publishedArticles = filterPublishedArticles(
    await getCollection("articles"),
  );

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      articles: publishedArticles.filter(
        ({ data }) => data.category === category.slug,
      ),
    },
  }));
}

interface Props {
  category: CategoryRecord;
  articles: PublishedArticleEntry[];
}

const { category, articles } = Astro.props;
const categoryEdition = partitionCategoryEdition(articles);
const archiveOpeningLabel =
  categoryEdition.layout === "archive"
    ? categoryEdition.featured.every(({ data }) => data.featured === true)
      ? "Featured guides"
      : categoryEdition.featured.some(({ data }) => data.featured === true)
        ? "Featured and latest guides"
        : "Latest guides"
    : "";
const path = `/categories/${category.slug}/`;
const title = `${category.name} for small business | ${site.name}`;
const description = category.description;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  socialImagePath={`/social/category-${category.slug}.png`}
  socialImageAlt={`Social preview for the ${category.name} topic.`}
  activeCategory={category.slug}
  editorialVisualSymbolIds={[category.slug]}
>
  <div
    class="page-shell category-page"
    data-guide-count={articles.length}
    data-layout={categoryEdition.layout}
  >
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: path },
      ]}
    />

    <header
      class="category-hero"
      data-category={category.slug}
      style={`--category-accent: ${category.accent};`}
    >
      <div class="category-hero__copy">
        <p class="eyebrow">Business technology topic</p>
        <h1>{category.name}</h1>
        <p class="page-deck">{category.description}</p>
        <p>{categoryPurposes[category.slug]}</p>
      </div>
      <div class="category-hero__visual" data-editorial-visual>
        <EditorialVisual
          category={category.slug}
          slug={`${category.slug}-category`}
          ratio="wide"
          fit="contain"
        />
      </div>
    </header>

    {
      categoryEdition.layout === "compact" ? (
        categoryEdition.articles.length > 0 ? (
          <section
            class="category-compact"
            aria-labelledby="category-compact-heading"
          >
            <SectionHeading
              eyebrow="Published guidance"
              title="All guides in this topic"
              description={`All ${formatGuideCount(categoryEdition.articles.length, `published ${category.name}`)} appear once. Homepage-featured guides come first; the rest follow the newest substantive article event, title, and slug.`}
              id="category-compact-heading"
            />
            <ol class="category-compact__list">
              {categoryEdition.articles.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="compact"
                    headingLevel={3}
                    showVisual={false}
                    showFullMeta={true}
                  />
                </li>
              ))}
            </ol>
          </section>
        ) : (
          <section class="empty-category" aria-labelledby="scope-heading">
            <h2 id="scope-heading">Current scope</h2>
            <p>
              This topic currently has no published guide. Only published
              entries that satisfy the site content contract appear here.
            </p>
          </section>
        )
      ) : categoryEdition.layout === "editorial" ? (
        <section
          class="category-editorial"
          aria-labelledby="category-editorial-heading"
        >
          <SectionHeading
            eyebrow="Published guidance"
            title="A guided topic edition"
            description={`All ${formatGuideCount(articles.length, `published ${category.name}`)} appear once. A featured guide leads when present; otherwise the newest guide leads.`}
            id="category-editorial-heading"
          />
          <div
            class="category-editorial__lead"
            aria-labelledby="category-lead-label"
          >
            <p class="eyebrow" id="category-lead-label">
              {categoryEdition.lead.data.featured
                ? "Featured lead guide"
                : "Latest guide"}
            </p>
            <ArticleCard
              article={categoryEdition.lead}
              variant="lead"
              headingLevel={3}
              showVisual={false}
              showFullMeta={true}
            />
          </div>
          <p class="eyebrow" id="category-supporting-label">
            Supporting guides
          </p>
          <ol
            class="category-editorial__features"
            aria-labelledby="category-supporting-label"
          >
            {categoryEdition.features.map((article) => (
              <li>
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                  showVisual={false}
                  showFullMeta={true}
                />
              </li>
            ))}
          </ol>
          {categoryEdition.remainder.length > 0 && (
            <ol class="category-editorial__remainder">
              {categoryEdition.remainder.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="list"
                    headingLevel={3}
                    showVisual={false}
                    showFullMeta={true}
                  />
                </li>
              ))}
            </ol>
          )}
        </section>
      ) : (
        <section
          class="category-archive"
          aria-labelledby="category-archive-heading"
        >
          <SectionHeading
            eyebrow="Complete topic archive"
            title="Browse the full topic collection"
            description={`All ${formatGuideCount(articles.length, `published ${category.name}`)} remain available once across a three-guide priority opening, the next three recent guides, and the complete archive.`}
            id="category-archive-heading"
          />
          {categoryEdition.featured.length > 0 && (
            <>
              <p class="eyebrow" id="category-featured-label">
                {archiveOpeningLabel}
              </p>
              <ol
                class="category-archive__featured"
                aria-labelledby="category-featured-label"
              >
                {categoryEdition.featured.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="feature"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
          {categoryEdition.recent.length > 0 && (
            <>
              <p class="eyebrow" id="category-recent-label">
                Recent guides
              </p>
              <ol
                class="category-archive__recent"
                aria-labelledby="category-recent-label"
              >
                {categoryEdition.recent.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="compact"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
          {categoryEdition.archive.length > 0 && (
            <>
              <p class="eyebrow" id="category-archive-label">
                More guides
              </p>
              <ol
                class="category-archive__remainder"
                aria-labelledby="category-archive-label"
              >
                {categoryEdition.archive.map((article) => (
                  <li>
                    <ArticleCard
                      article={article}
                      variant="list"
                      headingLevel={3}
                      showVisual={false}
                      showFullMeta={true}
                    />
                  </li>
                ))}
              </ol>
            </>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>
