---
import { getCollection } from "astro:content";

import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialVisual from "../../components/EditorialVisual.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import {
  categories,
  type CategoryRecord,
  type CategorySlug,
} from "../../data/categories";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { partitionCategoryEdition } from "../../utils/category-edition";
import {
  filterPublishedArticles,
  type PublishedArticleEntry,
} from "../../utils/published-articles";

const categoryPurposes: Record<CategorySlug, string> = {
  "ai-automation":
    "Use this section to decide where automation can remove repeat work without hiding judgment, accountability, or operational risk.",
  "business-software":
    "Use this section to compare software against real workflows, ownership cost, data portability, and the effort required to change later.",
  "cybersecurity-data-protection":
    "Use this section to turn broad security concerns into prioritized safeguards for accounts, devices, vendors, and business data.",
  "digital-operations":
    "Use this section to make routine digital work easier to hand off, verify, recover, and improve as the business changes.",
  "technology-strategy":
    "Use this section to connect technology spending and governance to business priorities, constraints, and measurable decisions.",
};

export async function getStaticPaths() {
  const publishedArticles = filterPublishedArticles(
    await getCollection("articles"),
  );

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      articles: publishedArticles
        .filter(({ data }) => data.category === category.slug)
        .sort(
          (left, right) =>
            Number(right.data.featured) - Number(left.data.featured) ||
            right.data.datePublished.localeCompare(left.data.datePublished) ||
            left.data.title.localeCompare(right.data.title, "en"),
        ),
    },
  }));
}

interface Props {
  category: CategoryRecord;
  articles: PublishedArticleEntry[];
}

const { category, articles } = Astro.props;
const categoryEdition = partitionCategoryEdition(articles);
const path = `/categories/${category.slug}/`;
const title = `${category.name} for small business | ${site.name}`;
const description = category.description;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  socialImagePath={`/social/category-${category.slug}.png`}
  socialImageAlt={`Social preview for the ${category.name} topic.`}
  activeCategory={category.slug}
  editorialVisualSymbolIds={[category.slug]}
>
  <div
    class="page-shell category-page"
    data-guide-count={articles.length}
    data-layout={categoryEdition.layout}
  >
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
        { name: category.name, href: path },
      ]}
    />

    <header
      class="category-hero"
      data-category={category.slug}
      style={`--category-accent: ${category.accent};`}
    >
      <div class="category-hero__copy">
        <p class="eyebrow">Business technology topic</p>
        <h1>{category.name}</h1>
        <p class="page-deck">{category.description}</p>
        <p>{categoryPurposes[category.slug]}</p>
      </div>
      <div class="category-hero__visual" data-editorial-visual>
        <EditorialVisual
          category={category.slug}
          slug={`${category.slug}-category`}
          ratio="wide"
          fit="contain"
        />
      </div>
    </header>

    {
      categoryEdition.layout === "compact" ? (
        categoryEdition.articles.length > 0 ? (
          <section
            class="category-compact"
            aria-labelledby="category-compact-heading"
          >
            <SectionHeading
              eyebrow="Published guidance"
              title="Guides in this topic"
              description={`All published ${category.name} guidance appears once in this concise directory.`}
              id="category-compact-heading"
            />
            <ol class="category-compact__list">
              {categoryEdition.articles.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="compact"
                    headingLevel={3}
                    showSummary
                    showVisual={false}
                  />
                </li>
              ))}
            </ol>
          </section>
        ) : (
          <section class="empty-category" aria-labelledby="scope-heading">
            <h2 id="scope-heading">Current scope</h2>
            <p>
              This category is available as part of the publication taxonomy. It
              currently has no published guide; only reviewed entries with
              complete source support appear here.
            </p>
          </section>
        )
      ) : categoryEdition.layout === "editorial" ? (
        <section
          class="category-editorial"
          aria-labelledby="category-editorial-heading"
        >
          <SectionHeading
            eyebrow="Published guidance"
            title="Featured and supporting guides"
            description={`Every published ${category.name} guide remains available once in this topic directory.`}
            id="category-editorial-heading"
          />
          <div class="category-editorial__lead">
            <ArticleCard
              article={categoryEdition.lead}
              variant="lead"
              headingLevel={3}
              showVisual={false}
            />
          </div>
          <ol class="category-editorial__features">
            {categoryEdition.features.map((article) => (
              <li>
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                  showVisual={false}
                />
              </li>
            ))}
          </ol>
          {categoryEdition.remainder.length > 0 && (
            <ol class="category-editorial__remainder">
              {categoryEdition.remainder.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="list"
                    headingLevel={3}
                    showSummary
                    showVisual={false}
                  />
                </li>
              ))}
            </ol>
          )}
        </section>
      ) : (
        <section
          class="category-archive"
          aria-labelledby="category-archive-heading"
        >
          <SectionHeading
            eyebrow="Complete topic archive"
            title="Featured, recent, and earlier guides"
            description={`All published ${category.name} guidance remains available in stable reading order.`}
            id="category-archive-heading"
          />
          <ol class="category-archive__featured">
            {categoryEdition.featured.map((article) => (
              <li>
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                  showVisual={false}
                />
              </li>
            ))}
          </ol>
          <ol class="category-archive__recent">
            {categoryEdition.recent.map((article) => (
              <li>
                <ArticleCard
                  article={article}
                  variant="compact"
                  headingLevel={3}
                  showSummary
                  showVisual={false}
                />
              </li>
            ))}
          </ol>
          {categoryEdition.archive.length > 0 && (
            <ol class="category-archive__remainder">
              {categoryEdition.archive.map((article) => (
                <li>
                  <ArticleCard
                    article={article}
                    variant="list"
                    headingLevel={3}
                    showSummary
                    showVisual={false}
                  />
                </li>
              ))}
            </ol>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>
