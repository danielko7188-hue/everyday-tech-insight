---
import { getCollection } from "astro:content";

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EditorialVisual from "../../components/EditorialVisual.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { categories } from "../../data/categories";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterPublishedArticles } from "../../utils/published-articles";

const publishedArticles = filterPublishedArticles(
  await getCollection("articles"),
);
const title = `Business technology categories | ${site.name}`;
const description =
  "Browse five practical business-technology categories covering automation, software, security, digital operations, and technology strategy.";
---

<BaseLayout
  title={title}
  description={description}
  path="/categories/"
  editorialVisualSymbolIds={categories.map(({ slug }) => slug)}
>
  <div class="page-shell category-directory-page">
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Categories", href: "/categories/" },
      ]}
    />
    <header class="page-intro">
      <p class="eyebrow">Topic directory</p>
      <h1>Business technology categories</h1>
      <p class="page-deck">
        Move from a business question to practical guidance organized around the
        problem, technology, risk, and next decision.
      </p>
    </header>

    <section
      class="category-directory"
      aria-labelledby="category-directory-heading"
    >
      <SectionHeading
        title="Explore the five-topic operating picture"
        description="Each topic keeps every reviewed, published guide together around a distinct decision focus."
        id="category-directory-heading"
      />
      <ol class="category-directory__list">
        {
          categories.map((category) => {
            const count = publishedArticles.filter(
              ({ data }) => data.category === category.slug,
            ).length;
            return (
              <li>
                <article
                  class="category-directory__entry"
                  data-category={category.slug}
                  style={`--category-accent: ${category.accent};`}
                >
                  <div class="category-directory__visual" data-editorial-visual>
                    <EditorialVisual
                      category={category.slug}
                      slug={category.slug}
                      ratio="landscape"
                    />
                  </div>
                  <div class="category-directory__copy">
                    <p class="category-directory__count">
                      {count === 1
                        ? "1 published guide"
                        : `${count} published guides`}
                    </p>
                    <h3>
                      <a href={`/categories/${category.slug}/`}>
                        {category.name}
                      </a>
                    </h3>
                    <p>{category.description}</p>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ol>
    </section>
  </div>
</BaseLayout>
