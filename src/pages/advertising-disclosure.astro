---
import { trustPages } from "../data/trust-pages";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";

const page = trustPages.advertisingDisclosure;
---

<TrustPageLayout page={page} currentKey="advertisingDisclosure">
  <p>
    No affiliate links, paid placements, sponsored articles, product samples, or
    other sponsored compensation are active in the published content. No AdSense
    code or publisher identifier is included.
  </p>
  <p>
    A link to a source is included for evidence and reader access; it is not
    presented as an endorsement. If commercial relationships are introduced, the
    relevant content and this disclosure must be updated before those
    relationships become active.
  </p>
  <p class="notice">
    Google alone decides whether a site is approved for AdSense. This site has
    not requested or received approval through this build.
  </p>
</TrustPageLayout>
