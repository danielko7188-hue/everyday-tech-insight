---
import { trustPages } from "../data/trust-pages";
import { site } from "../data/site";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import { integrationPublicCopy } from "../utils/monetization";

const page = trustPages.advertisingDisclosure;
const integrationCopy = integrationPublicCopy(site.integrations);
---

<TrustPageLayout page={page} currentKey="advertisingDisclosure">
  <p>
    The current deployed site contains no affiliate-link, paid-placement,
    sponsorship, or product-sample integrations.
  </p>
  <p>{integrationCopy.disclosureState}</p>
  <p>
    This technical state does not establish whether any off-site compensation or
    product provision exists. A link to a source is included for evidence and
    reader access; it is not presented as an endorsement. Before any commercial
    relationship affects publication, the owner must document it and update the
    relevant content and this disclosure.
  </p>
  <p class="notice">
    {integrationCopy.approvalBoundary}
  </p>
</TrustPageLayout>
