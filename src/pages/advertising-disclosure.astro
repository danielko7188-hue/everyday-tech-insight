---
import { trustPages } from "../data/trust-pages";
import { site } from "../data/site";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import { integrationPublicCopy } from "../utils/monetization";

const page = trustPages.advertisingDisclosure;
const integrationCopy = integrationPublicCopy(site.integrations);
---

<TrustPageLayout page={page} currentKey="advertisingDisclosure">
  <p>
    This website contains no affiliate-link, paid-placement, sponsorship, or
    product-sample integrations.
  </p>
  <p>{integrationCopy.disclosureState}</p>
  <p>
    Source links help readers check the evidence; they are not endorsements.
    This notice describes the website and does not establish the existence or
    absence of arrangements outside it. Any commercial relationship affecting a
    guide must be disclosed in that guide and reflected here.
  </p>
  <p class="notice">
    {integrationCopy.approvalBoundary}
  </p>
</TrustPageLayout>
