---
import { trustPages } from "../data/trust-pages";
import { site } from "../data/site";
import TrustPageLayout from "../layouts/TrustPageLayout.astro";
import { integrationPublicCopy } from "../utils/monetization";

const page = trustPages.privacy;
const integrationCopy = integrationPublicCopy(site.integrations);
---

<TrustPageLayout page={page} currentKey="privacy">
  <h2>When you browse</h2>
  <p>{integrationCopy.privacyState}</p>
  <p>
    You can read the guides and download worksheets without creating an account.
    This site has no contact form and does not collect form submissions on this
    domain. Its own code does not set cookies or store information in your
    browser's local or session storage.
  </p>
  <h2>Hosting request data</h2>
  <p>
    The site is hosted on Vercel. Delivering a page may involve Vercel
    processing request, device, network, diagnostic, and related service data.
    For details about the platform's practices, read the <a
      href="https://vercel.com/legal/privacy-notice">Vercel Privacy Notice</a
    >.
  </p>
  <h2>Public GitHub issues</h2>
  <p>
    Contact and correction links lead to GitHub rather than an on-site form. If
    a visitor chooses to open an issue, GitHub may process account, issue,
    device, and usage data under the <a
      href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
      >GitHub General Privacy Statement</a
    >. Issue text and account identity may be public.
  </p>
  <p class="notice">
    Do not submit private, confidential, account, payment, credential, or
    security-sensitive information through a public GitHub issue.
  </p>
  <h2>Changes to this notice</h2>
  <p>
    This notice must be updated before advertising, analytics, forms, embeds, or
    other features change the data practices described here. Questions about
    this notice can be raised through the <a href="/contact/"
      >public contact channel</a
    > without including personal or confidential information. Privacy rights and obligations
    depend on the applicable jurisdiction and circumstances.
  </p>
</TrustPageLayout>
