---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = `Privacy practices for this static site | ${site.name}`;
const description =
  "A factual description of the static site's current cookies, storage, analytics, advertising, contact, hosting, and public GitHub issue practices.";
---

<BaseLayout title={title} description={description} path="/privacy/">
  <div class="page-shell">
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Privacy", href: "/privacy/" },
      ]}
    />
    <article class="trust-content">
      <p class="eyebrow">Current site behavior</p>
      <h1>Privacy</h1>
      <p class="page-deck">
        This notice describes the code and services currently used by the static
        Everyday Tech Insight site as reviewed on August 21, 2026.
      </p>
      <h2>What this site's code does not collect</h2>
      <p>
        This site's code does not set cookies or use local storage. It has no
        analytics or advertising, no contact form, and no consent management
        platform. It does not intentionally collect names, email addresses, or
        form submissions on this domain.
      </p>
      <h2>Hosting request data</h2>
      <p>
        The site is configured for Vercel hosting. Vercel may process request,
        device, network, diagnostic, and related service data when a visitor
        asks its infrastructure to deliver a page. Vercel controls those
        platform practices; read the <a
          href="https://vercel.com/legal/privacy-notice"
          >Vercel Privacy Notice</a
        > for current details.
      </p>
      <h2>Public GitHub issues</h2>
      <p>
        Contact and correction links lead to GitHub rather than an on-site form.
        If a visitor chooses to open an issue, GitHub may process account,
        issue, device, and usage data under the <a
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          >GitHub General Privacy Statement</a
        >. Issue text and account identity may be public.
      </p>
      <p class="notice">
        Do not submit private, confidential, account, payment, credential, or
        security-sensitive information through a public GitHub issue.
      </p>
      <h2>Changes to this notice</h2>
      <p>
        Adding ads, analytics, embeds, a form, browser storage, or consent
        tooling would change the facts above and requires this page to be
        reviewed before that feature is activated. This notice is informational
        and does not make claims about legal rights that depend on a visitor's
        jurisdiction.
      </p>
    </article>
  </div>
</BaseLayout>
