---
import { getCollection } from "astro:content";

import ArticleCard from "../components/ArticleCard.astro";
import { categories } from "../data/categories";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const publishedArticles = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort((left, right) => {
  const dateOrder =
    Date.parse(`${right.data.datePublished}T00:00:00Z`) -
    Date.parse(`${left.data.datePublished}T00:00:00Z`);
  return dateOrder || left.data.title.localeCompare(right.data.title, "en");
});
const featuredCandidates = publishedArticles.filter(
  ({ data }) => data.featured,
);
const featuredLimit =
  publishedArticles.length > 1
    ? Math.min(4, publishedArticles.length - 1)
    : publishedArticles.length;
const featuredArticles = (
  featuredCandidates.length > 0 ? featuredCandidates : publishedArticles
).slice(0, featuredLimit);
const featuredSlugs = new Set(featuredArticles.map(({ data }) => data.slug));
const latestArticles = publishedArticles
  .filter(({ data }) => !featuredSlugs.has(data.slug))
  .slice(0, 4);
const title = `${site.name} | Practical Business Technology`;
const description =
  "Practical, source-backed guidance that helps small-business decision makers choose, use, secure, and govern everyday technology.";
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description,
  inLanguage: site.locale,
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  structuredData={websiteStructuredData}
>
  <div class="page-shell home-page">
    <section class="editorial-lead" aria-labelledby="home-heading">
      <div class="lead-copy">
        <p class="eyebrow">Independent practical guidance</p>
        <h1 id="home-heading">
          Practical business technology, explained clearly
        </h1>
        <p class="lead-summary">
          Everyday Tech Insight connects business needs and technology decisions
          for small-business decision makers who need useful next steps, not
          product hype.
        </p>
      </div>
      <div class="lead-note">
        <p>
          Each published guide starts with a business problem, identifies the
          relevant technology, defines the reader, and states a practical
          outcome.
        </p>
      </div>
    </section>

    <section
      class="category-section home-section"
      aria-labelledby="category-heading"
    >
      <p class="eyebrow">Explore by decision</p>
      <h2 id="category-heading">
        Five parts of the technology operating picture
      </h2>
      <p class="page-deck">
        Use the category index to move from a business question to focused,
        source-backed guidance.
      </p>
      <ul class="category-index">
        {
          categories.map((category) => (
            <li>
              <h2>
                <a href={`/categories/${category.slug}/`}>{category.name}</a>
              </h2>
              <p>{category.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      featuredArticles.length > 0 && (
        <section
          class="featured-section home-section"
          aria-labelledby="featured-heading"
        >
          <p class="eyebrow">Selected starting points</p>
          <h2 id="featured-heading">Featured practical guides</h2>
          <p class="section-summary">
            Start with these practical guides selected from across the
            publication's five business-technology categories.
          </p>
          <ul class="article-list">
            {featuredArticles.map((article) => (
              <li>
                <ArticleCard article={article} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section
      class="latest-section home-section"
      aria-labelledby="latest-heading"
    >
      <p class="eyebrow">Recently published</p>
      <h2 id="latest-heading">Latest published guides</h2>
      <p class="section-summary">
        Publication dates determine this order. Guides published on the same
        date are ordered by title for a stable, transparent index.
      </p>
      {
        latestArticles.length > 0 ? (
          <ul class="article-list">
            {latestArticles.map((article) => (
              <li>
                <ArticleCard article={article} headingLevel={3} />
              </li>
            ))}
          </ul>
        ) : publishedArticles.length > 0 ? (
          <p>
            The current published guide is featured above. The category index
            provides the full publication scope.
          </p>
        ) : (
          <p>
            No guides currently have published status. The category index
            describes the publication's scope.
          </p>
        )
      }
    </section>

    <section
      class="home-trust home-section"
      aria-labelledby="home-trust-heading"
    >
      <p class="eyebrow">Trust and accountability</p>
      <h2 id="home-trust-heading">How this publication works</h2>
      <div class="home-trust-grid">
        <article>
          <h3>Editorial standards</h3>
          <p>
            Guides state who they are for, the outcome they support, and the
            sources reviewed. Our <a href="/editorial-standards/"
              >Editorial standards</a
            > explain sourcing, verification labels, corrections, and the line between
            evidence and inference.
          </p>
        </article>
        <article>
          <h3>Publisher and contact</h3>
          <p>
            Everyday Tech Insight is the publication-name byline used on this
            site. It does not identify a named person, legal entity,
            credentialed team, or hands-on product-testing operation. Read the
            {" "}<a href="/publisher/">Publisher</a> boundary or use{" "}<a
              href="/contact/">Contact</a
            > for a public issue without private information.
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
