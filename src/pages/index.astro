---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustModule from "../components/TrustModule.astro";
import { categories } from "../data/categories";
import { allocateHomepageEdition } from "../data/editorial";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

type ArticleEntry = CollectionEntry<"articles">;

const compareArticles = (left: ArticleEntry, right: ArticleEntry) => {
  const dateOrder =
    Date.parse(`${right.data.datePublished}T00:00:00Z`) -
    Date.parse(`${left.data.datePublished}T00:00:00Z`);
  return dateOrder || left.data.title.localeCompare(right.data.title, "en");
};

const allArticles = await getCollection("articles");
const publishedArticles = allArticles
  .filter(({ data }) => data.status === "published")
  .sort(compareArticles);
const homepageEdition = allocateHomepageEdition(publishedArticles);
const [leadArticle] = homepageEdition.lead;
const featureArticles = homepageEdition.features;
const briefingArticles = homepageEdition.briefing;
const startHereArticles = homepageEdition.startHere;
const moreGuides = homepageEdition.moreGuides;
const topicCounts = new Map(
  categories.map((category) => [
    category.slug,
    publishedArticles.filter(
      (article) => article.data.category === category.slug,
    ).length,
  ]),
);

const title = `${site.name} | Practical Business Technology`;
const description =
  "Practical, source-backed guidance that helps small-business decision makers choose, use, secure, and govern everyday technology.";
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description,
  inLanguage: site.locale,
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  includeEditorialVisualSymbols
  structuredData={websiteStructuredData}
>
  <div class="page-shell home-page">
    <header class="home-opening">
      <div class="home-opening__promise">
        <p class="eyebrow">Independent practical guidance</p>
        <h1>Practical business technology, explained clearly</h1>
        <p class="lead-summary">
          Source-backed guidance for small-business technology decisions,
          without product hype.
        </p>
      </div>
      <section class="front-page" aria-labelledby="front-page-heading">
        <h2 id="front-page-heading" class="visually-hidden">Current issue</h2>
        <div class="front-page__lead">
          {
            leadArticle && (
              <ArticleCard
                article={leadArticle}
                variant="lead"
                headingLevel={3}
              />
            )
          }
        </div>
        <div class="front-page__support">
          {
            featureArticles.map((article) => (
              <ArticleCard
                article={article}
                variant="feature"
                headingLevel={3}
              />
            ))
          }
        </div>
      </section>
    </header>

    <TrustModule />

    <section
      class="home-section latest-briefing"
      aria-labelledby="latest-briefing-heading"
    >
      <SectionHeading
        eyebrow="Latest"
        title="Latest briefing"
        description="Three current guides for practical technology decisions."
        id="latest-briefing-heading"
      />
      <ol class="latest-briefing__list">
        {
          briefingArticles.map((article) => (
            <li>
              <ArticleCard
                article={article}
                variant="list"
                headingLevel={3}
                showSummary
              />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section start-here"
      aria-labelledby="start-here-heading"
    >
      <SectionHeading
        eyebrow="Practical foundations"
        title="Start here"
        description="Begin with a bounded guide that produces a useful record, test, or decision."
        id="start-here-heading"
      />
      <ol class="start-here__list">
        {
          startHereArticles.map((article) => (
            <li>
              <ArticleCard
                article={article}
                variant="list"
                headingLevel={3}
                showSummary
              />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section topic-directory topic-directory--compact"
      aria-labelledby="topics-heading"
    >
      <SectionHeading
        eyebrow="Five decision areas"
        title="Browse by topic"
        description="Choose the business decision area that matches the work in front of you."
        href="/categories/"
        linkLabel="View all topics"
        id="topics-heading"
      />
      <ol>
        {
          categories.map((category) => (
            <li
              data-category={category.slug}
              style={`--category-accent: ${category.accent};`}
            >
              <a href={`/categories/${category.slug}/`}>
                <span>{category.name}</span>
                <span>{topicCounts.get(category.slug)} guides</span>
              </a>
              <p>{category.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section more-guides"
      aria-labelledby="more-guides-heading"
    >
      <SectionHeading
        eyebrow="Complete issue"
        title="More guides"
        description="The remaining published guides, kept in a stable reading order."
        id="more-guides-heading"
      />
      <ol>
        {
          moreGuides.map((article) => (
            <li>
              <ArticleCard article={article} variant="list" headingLevel={3} />
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
