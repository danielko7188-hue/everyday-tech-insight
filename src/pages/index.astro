---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustModule from "../components/TrustModule.astro";
import { categories } from "../data/categories";
import { homepageCuration } from "../data/editorial";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

type ArticleEntry = CollectionEntry<"articles">;

const compareArticles = (left: ArticleEntry, right: ArticleEntry) => {
  const dateOrder =
    Date.parse(`${right.data.datePublished}T00:00:00Z`) -
    Date.parse(`${left.data.datePublished}T00:00:00Z`);
  return dateOrder || left.data.title.localeCompare(right.data.title, "en");
};

const publishedArticles = (
  await getCollection("articles", ({ data }) => data.status === "published")
).sort(compareArticles);
const articlesBySlug = new Map(
  publishedArticles.map((article) => [article.data.slug, article]),
);
const selectedPrimarySlugs = new Set<string>();

function takeCurated(slugs: readonly string[], count: number): ArticleEntry[] {
  const selected: ArticleEntry[] = [];

  for (const slug of slugs) {
    const article = articlesBySlug.get(slug);
    if (article && !selectedPrimarySlugs.has(slug)) {
      selected.push(article);
      selectedPrimarySlugs.add(slug);
    }
    if (selected.length === count) return selected;
  }

  for (const article of publishedArticles) {
    if (!selectedPrimarySlugs.has(article.data.slug)) {
      selected.push(article);
      selectedPrimarySlugs.add(article.data.slug);
    }
    if (selected.length === count) break;
  }

  return selected;
}

const [leadArticle] = takeCurated(homepageCuration.lead, 1);
const featureArticles = takeCurated(homepageCuration.features, 2);
const briefingArticles = takeCurated(homepageCuration.briefing, 3);
const startHereArticles = takeCurated(homepageCuration.startHere, 3);
const latestArticles = publishedArticles.filter(
  (article) => !selectedPrimarySlugs.has(article.data.slug),
);
const topicArticles = new Map(
  categories.map((category) => [
    category.slug,
    publishedArticles
      .filter((article) => article.data.category === category.slug)
      .sort(
        (left, right) =>
          Number(right.data.featured) - Number(left.data.featured) ||
          compareArticles(left, right),
      )
      .slice(0, 3),
  ]),
);

const title = `${site.name} | Practical Business Technology`;
const description =
  "Practical, source-backed guidance that helps small-business decision makers choose, use, secure, and govern everyday technology.";
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description,
  inLanguage: site.locale,
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  structuredData={websiteStructuredData}
>
  <div class="page-shell home-page">
    <header class="home-hero">
      <div class="home-hero__copy">
        <p class="eyebrow">Independent practical guidance</p>
        <h1>Practical business technology, explained clearly</h1>
        <p class="lead-summary">
          Everyday Tech Insight connects business needs and technology decisions
          for small-business decision makers who need useful next steps, not
          product hype.
        </p>
      </div>
      <p class="home-hero__note">
        Each guide starts with a business problem, defines who it serves, and
        states the practical outcome it supports.
      </p>
    </header>

    {
      leadArticle && (
        <section
          class="home-section top-stories"
          aria-labelledby="top-stories-heading"
        >
          <SectionHeading
            eyebrow="Editorial selection"
            title="Top stories"
            description="Selected starting points chosen for their practical range across the publication, not popularity or trend claims."
            id="top-stories-heading"
          />
          <div class="top-stories__grid">
            <ArticleCard
              article={leadArticle}
              variant="lead"
              headingLevel={3}
            />
            <div class="top-stories__features">
              {featureArticles.map((article) => (
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <AdSlot size="leaderboard" class="home-page__ad-slot" />

    <section
      class="home-section latest-briefing"
      aria-labelledby="latest-briefing-heading"
    >
      <SectionHeading
        eyebrow="Three practical reads"
        title="Latest briefing"
        description="A concise cross-section of current publication guidance, selected editorially from the launch collection."
        id="latest-briefing-heading"
      />
      <ol class="latest-briefing__list">
        {
          briefingArticles.map((article) => (
            <li>
              <ArticleCard
                article={article}
                variant="compact"
                headingLevel={3}
              />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section start-here"
      aria-labelledby="start-here-heading"
    >
      <SectionHeading
        eyebrow="Practical foundations"
        title="Start here"
        description="Begin with bounded guides that produce a concrete record, test, or decision."
        id="start-here-heading"
      />
      <div class="start-here__grid">
        {
          startHereArticles.map((article) => (
            <ArticleCard
              article={article}
              variant="standard"
              headingLevel={3}
            />
          ))
        }
      </div>
    </section>

    <AdSlot size="leaderboard" class="home-page__ad-slot" />

    <div class="home-topics" aria-label="Publication topics">
      {
        categories.map((category, categoryIndex) => (
          <section
            class:list={[
              "home-section",
              "topic-section",
              {
                "topic-section--reverse": categoryIndex % 2 === 1,
              },
            ]}
            data-category={category.slug}
            style={`--category-accent: ${category.accent};`}
            aria-labelledby={`topic-${category.slug}-heading`}
          >
            <SectionHeading
              eyebrow="Topic"
              title={category.name}
              description={category.description}
              href={`/categories/${category.slug}/`}
              linkLabel={`View all ${category.name}`}
              id={`topic-${category.slug}-heading`}
            />
            <div class="topic-section__stories">
              {topicArticles
                .get(category.slug)
                ?.map((article, articleIndex) => (
                  <ArticleCard
                    article={article}
                    variant={articleIndex === 0 ? "standard" : "compact"}
                    headingLevel={3}
                  />
                ))}
            </div>
          </section>
        ))
      }
    </div>

    <section
      class="home-section latest-articles"
      aria-labelledby="latest-articles-heading"
    >
      <SectionHeading
        eyebrow="Complete the launch collection"
        title="Latest articles"
        description="The remaining published guides, ordered by publication date and title for a stable index."
        href="/categories/"
        linkLabel="Browse every topic"
        id="latest-articles-heading"
      />
      <ol class="latest-articles__list">
        {
          latestArticles.map((article) => (
            <li>
              <ArticleCard article={article} variant="list" headingLevel={3} />
            </li>
          ))
        }
      </ol>
    </section>

    <TrustModule />
  </div>
</BaseLayout>
