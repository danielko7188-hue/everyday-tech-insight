---
import { getCollection } from "astro:content";

import ArticleCard from "../components/ArticleCard.astro";
import EditorialVisual from "../components/EditorialVisual.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustModule from "../components/TrustModule.astro";
import { categories } from "../data/categories";
import { resolveHomepageCuration } from "../data/editorial";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  filterPublishedArticles,
  type PublishedArticleEntry,
} from "../utils/published-articles";

const compareArticles = (
  left: PublishedArticleEntry,
  right: PublishedArticleEntry,
) => {
  const dateOrder =
    Date.parse(`${right.data.datePublished}T00:00:00Z`) -
    Date.parse(`${left.data.datePublished}T00:00:00Z`);
  return dateOrder || left.data.title.localeCompare(right.data.title, "en");
};

const publishedArticles = filterPublishedArticles(
  await getCollection("articles"),
).sort(compareArticles);
const homepageSelection = resolveHomepageCuration(publishedArticles);
const [leadArticle] = homepageSelection.lead;
const featureArticles = homepageSelection.features;
const briefingArticles = homepageSelection.briefing;
const startHereArticles = homepageSelection.startHere;
const topicCounts = new Map(
  categories.map((category) => [
    category.slug,
    publishedArticles.filter(
      (article) => article.data.category === category.slug,
    ).length,
  ]),
);
const editorialVisualSymbolIds = [
  ...(leadArticle ? [leadArticle.data.visual.key] : []),
  ...featureArticles.map(({ data }) => data.visual.key),
  ...categories.map(({ slug }) => slug),
];

const title = `${site.name} | Practical Business Technology`;
const description =
  "Practical, source-backed guidance that helps small-business decision makers choose, use, secure, and govern everyday technology.";
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description,
  inLanguage: site.locale,
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  editorialVisualSymbolIds={editorialVisualSymbolIds}
  structuredData={websiteStructuredData}
>
  <div class="page-shell home-page">
    <header class="home-opening">
      <div class="home-opening__inner">
        <div class="home-opening__promise">
          <p class="eyebrow">Practical business technology</p>
          <h1>Make technology decisions you can explain.</h1>
          <p class="lead-summary">
            Independent, source-backed guides for choosing, securing, and
            governing the tools your business relies on, without product hype.
          </p>
        </div>
        <section class="front-page" aria-labelledby="front-page-heading">
          <h2 id="front-page-heading" class="visually-hidden">
            Featured guidance
          </h2>
          <div class="front-page__lead">
            {
              leadArticle && (
                <ArticleCard
                  article={leadArticle}
                  variant="lead"
                  headingLevel={3}
                />
              )
            }
          </div>
          <div class="front-page__support">
            {
              featureArticles.map((article) => (
                <ArticleCard
                  article={article}
                  variant="feature"
                  headingLevel={3}
                />
              ))
            }
          </div>
        </section>
      </div>
    </header>

    <section
      class="home-section latest-briefing"
      aria-labelledby="latest-briefing-heading"
    >
      <SectionHeading
        eyebrow="Latest"
        title="Latest guides"
        description="Three current guides for practical technology decisions."
        id="latest-briefing-heading"
      />
      <ol class="latest-briefing__list">
        {
          briefingArticles.map((article) => (
            <li>
              <ArticleCard article={article} variant="list" headingLevel={3} />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section start-here"
      aria-labelledby="start-here-heading"
    >
      <SectionHeading
        eyebrow="Start with the essentials"
        title="Practical foundations"
        description="Begin with a bounded guide that produces a useful record, test, or decision."
        href="/articles/"
        linkLabel="View all guides"
        id="start-here-heading"
      />
      <ol class="start-here__list">
        {
          startHereArticles.map((article) => (
            <li>
              <ArticleCard article={article} variant="list" headingLevel={3} />
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section topic-directory topic-directory--compact"
      aria-labelledby="topics-heading"
    >
      <SectionHeading
        eyebrow="Five decision areas"
        title="Browse by topic"
        description="Choose the business decision area that matches the work in front of you."
        href="/categories/"
        linkLabel="View all topics"
        id="topics-heading"
      />
      <ol>
        {
          categories.map((category) => (
            <li
              data-category={category.slug}
              style={`--category-accent: ${category.accent};`}
            >
              <div class="topic-directory__motif" data-editorial-visual>
                <EditorialVisual
                  category={category.slug}
                  slug={`${category.slug}-home-topic`}
                  ratio="wide"
                  fit="contain"
                />
              </div>
              <a href={`/categories/${category.slug}/`}>
                <span>{category.name}</span>
                <span>{topicCounts.get(category.slug)} guides</span>
              </a>
              <p>{category.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="home-section featured-toolkit"
      aria-labelledby="featured-toolkit-heading"
    >
      <header class="featured-toolkit__heading">
        <p class="eyebrow">Use the lead guide</p>
        <h2 id="featured-toolkit-heading">Featured Toolkit resource</h2>
      </header>
      <div class="featured-toolkit__body">
        <div>
          <h3>Automation candidate screen</h3>
          <p>
            This blank worksheet follows the lead guide's decision sequence:
            record a bounded task, its exceptions and failure consequences, the
            human review point, and a usable fallback before deciding on a
            pilot.
          </p>
        </div>
        <p class="featured-toolkit__actions">
          <a href="/articles/how-to-identify-business-tasks-for-automation/">
            Read the automation-candidate guide
          </a>
          <a href="/toolkit/automation-candidate-screen.csv" download>
            Download automation screen CSV
          </a>
        </p>
      </div>
    </section>

    <TrustModule />
  </div>
</BaseLayout>
