---
import { getCollection } from "astro:content";

import Breadcrumbs from "../components/Breadcrumbs.astro";
import ToolkitCard from "../components/ToolkitCard.astro";
import { toolkitResourceHasPublishedGuide } from "../data/editorial";
import { site } from "../data/site";
import { toolkitResources } from "../data/toolkit";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = `Business technology decision toolkit | ${site.name}`;
const description =
  "Download four blank CSV worksheets for screening automation, evaluating SaaS, recording technology risk, and testing backup restoration.";
const articles = await getCollection("articles");
---

<BaseLayout title={title} description={description} path="/toolkit/">
  <div class="page-shell toolkit-page-shell">
    <Breadcrumbs
      items={[
        { name: "Home", href: "/" },
        { name: "Toolkit", href: "/toolkit/" },
      ]}
    />
    <article class="toolkit-page">
      <header class="toolkit-hero surface-dark">
        <p class="eyebrow">Blank working records</p>
        <h1>Business technology decision toolkit</h1>
        <p class="page-deck">
          Four blank worksheets turn practical guides into records a small team
          can adapt, review, and retain.
        </p>
      </header>
      <p class="toolkit-introduction">
        Each CSV contains headers only. Make a working copy, define the
        business's scales and evidence rules, assign a real owner, and preserve
        the completed record with the decision it supports. A worksheet records
        a review; it does not certify the decision or the control.
      </p>
      <div class="toolkit-grid">
        {
          toolkitResources.map((resource) => (
            <ToolkitCard
              resource={resource}
              showGuideLink={toolkitResourceHasPublishedGuide(
                resource,
                articles,
              )}
            />
          ))
        }
      </div>
      <aside
        class="toolkit-safety-note notice"
        aria-labelledby="toolkit-safety-heading"
      >
        <h2 id="toolkit-safety-heading">Use the worksheets safely</h2>
        <p>
          These are blank editorial templates, not completed assessments,
          observed business results, legal advice, security certification, or
          proof that a control works. Adapt them to the real workflow and obtain
          qualified review where the consequences require it. Never put
          passwords, tokens, recovery keys, authentication secrets, or raw
          confidential data in these files. Record only the minimum necessary
          reference, custodian, approved storage location, or access procedure,
          and protect completed copies under the referenced data's access,
          retention, and secure disposal rules.
        </p>
      </aside>
    </article>
  </div>
</BaseLayout>
